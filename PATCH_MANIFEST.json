{
  "name": "youtube-creator-intelligence-hub-neutral-surface-overlay",
  "version": "4.2.0",
  "schema_version": 18,
  "database_included": false,
  "upgrade_compatible": true,
  "behavior_changes": [
    "generic workspaces do not inherit unscoped historical metric configuration",
    "browser metric state is namespaced by workspace",
    "compatibility templates are hidden and never auto-activated",
    "dashboard default examples, relationships, result columns and detail sorting are domain-neutral",
    "synthetic demo includes a public-surface neutrality gate",
    "neutrality checker works from Windows batch/module entrypoints and direct file execution"
  ],
  "runtime_modified_files": [
    "creator_hub/dashboard.py",
    "creator_hub/metric_workspace.py",
    "creator_hub/static/metrics_workspace.js",
    "creator_hub/workspace.py",
    "config/workspace_templates.json"
  ],
