{
  "name": "youtube-creator-intelligence-hub-workspace-query-pack-editor-overlay",
  "version": "4.4.0",
  "schema_version": 18,
  "database_included": false,
  "upgrade_compatible": true,
  "migration_strategy": "idempotent V4.2/V4.3 neutralization followed by Workspace-scoped Query Pack schema-4 migration; user edits retained",
  "behavior_changes": [
    "Query Expansion groups are fully editable Workspace-scoped strategy objects",
    "group name and description can be edited in place",
    "groups can be added, duplicated, deleted and reordered",
    "per-language term lists and active selections remain independently editable",
    "built-in groups support one-group restore, current-language restore and full catalog restore",
    "browser Query Pack state moves to Workspace-scoped v4 storage",
    "SQLite query_profile moves to schema 4 / generic_creator_discovery_v2",
    "V4.3 enable states, term edits and active selections are migrated instead of reset",
    "schema-4 user-defined groups are preserved by normal upgrades"
  ],
  "runtime_modified_files": [
    "creator_hub/dashboard.py",
    "creator_hub/static/discovery.js",
    "config/query_packs.json"
  ],
  "database_migration": [
    "Schema remains 18",
    "production Creator/Video/Snapshot/Discovery facts are not changed",
    "pre-4.4 generic query_profile is backed up once to query_profile_pre_editor_4_4",
    "V4.3 Query Pack edits are retained during conversion",
    "existing V4.4 schema-4 profiles are left unchanged"
  ],
  "validation": [
    "all overlay Python files compile",
    "all JSON/JSONL parse",
    "Windows CMD entry points are ASCII CRLF",
    "focused Query Pack migration tests pass",
    "V3-to-V4 JavaScript state migration harness passes under Node",
    "generated Query Pack editor JavaScript passes node --check"
  ],
